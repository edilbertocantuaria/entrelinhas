# Copie para .env e preencha. O .env não deve ir para o repositório.
# Nenhuma destas chaves pode ter o prefixo NEXT_PUBLIC_: elas ficam só no servidor.

# ── Banco de dados (PostgreSQL, usado por prisma/schema.prisma) ──
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/entrelinhas?schema=public"

# ── Login ──
# Segredo para assinar a sessão. Gere um com: openssl rand -base64 32
AUTH_SECRET=""
# Endereço público do app
APP_URL="http://localhost:3000"

# ── IA dos resumos ──
# Qual serviço usar: openai, anthropic ou gemini.
# Se a chave do escolhido estiver vazia, o app usa a que estiver preenchida.
# Os prompts de cada situação ficam em src/utils/prompts.
LLM_PROVIDER="openai"
# Opcional: modelo da IA principal. Vazio = padrão do adaptador (src/apis/ai/providers).
LLM_MODEL=""
# Opcional: IAs de reserva, em ordem, se a principal falhar. Ex.: "anthropic,gemini"
LLM_FALLBACK=""
# Opcional: IA por situação (nomes dos arquivos de src/utils/prompts).
# Ex.: "resumo-trimestral=anthropic,estudos-insights=gemini"
LLM_ROUTES=""

# Chaves: preencha as que tiver. IA sem chave é pulada.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Opcional: modelo de cada IA quando ela entra como reserva ou por rota.
OPENAI_MODEL=""
ANTHROPIC_MODEL=""
GEMINI_MODEL=""
